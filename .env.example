# POLYPRO — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real credentials.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Polymarket API (Clob)
POLYMARKET_URL=https://clob.polymarket.com/markets
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_api_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here
POLYMARKET_FUNDER=your_funder_address_here
POLYMARKET_SIG_TYPE=1

# Wallet
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Internal auth token for discovery trigger endpoint
TRIGGER_AUTH_TOKEN=your_trigger_token_here

# Scheduler
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_SCHEDULER_INTERVAL=3600

# Storage paths (relative to backend/)
MARKET_STORE_PATH=data/markets.db
AUTH_DB_PATH=data/auth.db

# Frontend (Vite)
VITE_BACKEND_URL=http://127.0.0.1:8000
